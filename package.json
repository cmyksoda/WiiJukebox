{
  "name": "wiijukebox",
  "version": "0.1.0",
  "description": "One persistent audio stream for WiiRadio, fed from any source you like",
  "main": "src/main.js",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/main.js",
    "smoke": "node test/smoke-pipeline.js",
    "vendor": "mkdir -p public/vendor && cp node_modules/butterchurn/dist/butterchurn.min.js node_modules/butterchurn-presets/dist/base.min.js node_modules/butterchurn-presets/dist/extra.min.js node_modules/butterchurn-presets/dist/md1.min.js public/vendor/",
    "postinstall": "npm run vendor"
  },
  "dependencies": {
    "butterchurn": "^3.0.0-beta.5",
    "butterchurn-presets": "^3.0.0-beta.4"
  }
}
