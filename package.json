{
  "name": "wiijukebox",
  "version": "0.1.0",
  "description": "A Wii music player and server for your library, radio and streaming links",
  "main": "src/main.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/main.js",
    "smoke": "node test/smoke-pipeline.js",
    "test:ytdlp": "node test/ytdlp-live.js",
    "vendor": "node tools/vendor.js",
    "postinstall": "npm run vendor",
    "test": "make -C client host-test && node --test test/*.test.js",
    "build:client": "make -C client",
    "test:navidrome": "python3 test/navidrome-fixture.py",
    "package:client": "make -C client package"
  },
  "dependencies": {
    "butterchurn": "^3.0.0-beta.5",
    "butterchurn-presets": "^3.0.0-beta.4"
  }
}
