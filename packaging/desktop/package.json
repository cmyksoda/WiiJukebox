{
  "name": "wiijukebox-desktop",
  "productName": "WiiJukebox",
  "version": "0.1.0",
  "private": true,
  "description": "WiiJukebox server in a native window",
  "author": "WiiJukebox contributors",
  "homepage": "https://github.com/cmyksoda/WiiJukebox",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "stage": "node scripts/stage.js",
    "start": "electron . --no-sandbox",
    "icons": "python3 scripts/make-icons.py",
    "dist:linux": "node scripts/stage.js linux && electron-builder --linux AppImage --x64 --publish never",
    "dist:linux-deb": "node scripts/stage.js linux && electron-builder --linux deb --x64 --publish never",
    "dist:linux-rpm": "node scripts/stage.js linux && electron-builder --linux rpm --x64 --publish never",
    "dist:win": "node scripts/stage.js win && electron-builder --win zip nsis --x64 --publish never",
    "dist:mac-arm64": "node scripts/stage.js mac-arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac-x64": "node scripts/stage.js mac-x64 && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac": "npm run dist:mac-arm64 && npm run dist:mac-x64",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "electron": "41.7.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.wiijukebox.desktop",
    "productName": "WiiJukebox",
    "copyright": "GPL-3.0-only",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "titlebar-preload.js",
      "close-preload.js",
      "ui/**",
      "assets/**",
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "executableName": "wiijukebox",
      "syncDesktopName": true,
      "maintainer": "WiiJukebox contributors",
      "vendor": "WiiJukebox contributors",
      "synopsis": "Plays your music to the Wii",
      "description": "Plays your library, radio, podcasts and streaming links to a Wii over the local network.",
      "desktop": {
        "entry": {
          "Comment": "Plays your library, radio, podcasts and streaming links to a Wii over the local network.",
          "Categories": "AudioVideo;Audio;Player;",
          "Keywords": "Wii;music;jukebox;stream;radio;podcast;"
        }
      }
    },
    "appImage": {
      "artifactName": "WiiJukebox-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "wiijukebox_${version}_${arch}.${ext}",
      "packageName": "wiijukebox"
    },
    "rpm": {
      "artifactName": "wiijukebox-${version}-1.${arch}.${ext}",
      "packageName": "wiijukebox",
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "WiiJukebox-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WiiJukebox",
      "artifactName": "WiiJukebox-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "WiiJukebox-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "WiiJukebox lets your Wii find this computer and play music from it over your local network."
      }
    },
    "dmg": {
      "title": "WiiJukebox ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "desktopName": "wiijukebox.desktop"
}
